# 复制本文件为 .env 并填写。.env 不会被提交到 git。
# 授权码不是邮箱登录密码：QQ/163 邮箱在「设置 → 账户 → POP3/SMTP 服务」里开启后生成。

# 发信服务器。常见：QQ 邮箱 smtp.qq.com，163 邮箱 smtp.163.com，Gmail smtp.gmail.com
SMTP_HOST=smtp.qq.com
# 465 用 SSL，587 用 STARTTLS
SMTP_PORT=465
# 发信邮箱地址
SMTP_USER=
# 发信邮箱的 SMTP 授权码
SMTP_PASSWORD=
# 收件人，多个用英文逗号分隔
MAIL_TO=
